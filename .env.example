# --- Discord (from https://discord.com/developers/applications) ---
DISCORD_TOKEN=paste-bot-token-here
DISCORD_CLIENT_ID=paste-application-id-here
DISCORD_CLIENT_SECRET=paste-oauth2-client-secret-here

# --- Dashboard ---
# The public address of the dashboard. Discord's OAuth2 redirect must be PUBLIC_URL + /callback
PUBLIC_URL=https://mafia.poor.camp
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Long random string; generate with:  python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Storage ---
DB_PATH=/opt/modfather/data/modfather.db

# --- Optional ---
# A server id to register slash commands on instantly while testing (global sync can take up to an hour)
DEV_GUILD_ID=
# "VOTE: name" parsing needs the Message Content intent turned on in the developer portal
TEXT_VOTES=true
# Timezone used to read hosts' deadline times ("Nov 24 8pm") until a server sets its own with /mafia config
DEFAULT_TIMEZONE=America/Chicago
